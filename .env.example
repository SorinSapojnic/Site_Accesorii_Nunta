# ── Copiază acest fișier în ".env" și completează valorile ──

# Port server (implicit 3000)
PORT=3000

# Parolă admin (default: Nunta2024)
ADMIN_PASSWORD=Nunta2024

# Secret JWT – schimbă cu un șir random lung!
JWT_SECRET=schimba_acest_secret_cu_ceva_random_lung_2024

# Email de la care se trimit comenzile (Gmail recomandat)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=adresa_ta@gmail.com
EMAIL_PASS=parola_aplicatie_gmail

# Email unde vin comenzile
ORDER_EMAIL=nicolae.grincu@mail.ru
